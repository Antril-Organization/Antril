{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Antril",
  "scopeName": "source.antril",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#sections"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.antril",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.antril",
          "match": "//.*$"
        },
        {
          "name": "comment.block.antril",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "meta.attribute.antril",
          "begin": "(?<=^|[\\s(,])\\[(?=\\s*[A-Z][\\w.]*\\s*(\\(|\\]|,))",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.attribute.begin.antril"
            }
          },
          "end": "\\]",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.attribute.end.antril"
            }
          },
          "patterns": [
            {
              "match": "\\b[A-Z][\\w.]*\\b(?=\\s*(\\(|\\]|,))",
              "name": "entity.name.type.attribute.antril"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#keywords"
            },
            {
              "include": "#types"
            }
          ]
        }
      ]
    },
    "sections": {
      "patterns": [
        {
          "match": "^\\s*(public|private|internal|friendly|inherited|file)\\s*(:)\\s*$",
          "captures": {
            "1": {
              "name": "storage.modifier.access.antril"
            },
            "2": {
              "name": "punctuation.separator.colon.antril"
            }
          }
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "comment": "import A.B;",
          "match": "\\b(import)\\s+([\\w.]+)",
          "captures": {
            "1": {
              "name": "keyword.other.antril"
            },
            "2": {
              "name": "entity.name.namespace.antril"
            }
          }
        },
        {
          "match": "\\b(static\\s+ext|ext)\\s*(?=[<(])",
          "captures": {
            "1": {
              "name": "storage.type.antril"
            }
          }
        },
        {
          "match": "\\b(record\\s+class|record\\s+value|base\\s+class|static\\s+class|bitflag\\s+enum|class|value|interface|enum|attribute|exception)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": {
              "name": "storage.type.antril"
            },
            "2": {
              "name": "entity.name.type.antril"
            }
          }
        },
        {
          "match": "\\b(func)\\s+([A-Za-z_]\\w*)\\s*(?=[<(])",
          "captures": {
            "1": {
              "name": "storage.type.func.antril"
            },
            "2": {
              "name": "entity.name.type.antril"
            }
          }
        },
        {
          "match": "\\b(into)\\s+(namespace)\\s+([\\w.]+)",
          "captures": {
            "1": {
              "name": "keyword.other.antril"
            },
            "2": {
              "name": "keyword.other.antril"
            },
            "3": {
              "name": "entity.name.namespace.antril"
            }
          }
        },
        {
          "match": "\\b(import)\\s+(?:([A-Za-z_]\\w*)\\s*(<[^>]*>)\\s*(from)\\s+)?([\\w.]+)",
          "captures": {
            "1": {
              "name": "keyword.other.import.antril"
            },
            "2": {
              "name": "entity.name.type.antril"
            },
            "4": {
              "name": "keyword.other.antril"
            },
            "5": {
              "name": "meta.namespace.import.antril"
            }
          }
        },
        {
          "match": "\\b(op)\\s*(\\(\\s*[^)]*\\)|[^\\s(\\w]+)",
          "captures": {
            "1": {
              "name": "storage.type.operator.antril"
            },
            "2": {
              "name": "entity.name.function.operator.antril"
            }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.antril",
          "begin": "\"",
          "end": "\"|$",
          "patterns": [
            {
              "name": "constant.character.escape.antril",
              "match": "\\\\(u\\{?[0-9A-Fa-f]+\\}?|x[0-9A-Fa-f]+|.)"
            }
          ]
        },
        {
          "name": "string.quoted.single.antril",
          "match": "'(\\\\(u\\{?[0-9A-Fa-f]+\\}?|x[0-9A-Fa-f]+|.)|[^'\\\\])'",
          "captures": {
            "2": {
              "name": "constant.character.escape.antril"
            }
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.antril",
          "match": "\\b0[xX][0-9A-Fa-f_]+(_?[iuf]\\d+)?\\b"
        },
        {
          "name": "constant.numeric.binary.antril",
          "match": "\\b0[bB][01_]+(_?[iuf]\\d+)?\\b"
        },
        {
          "name": "constant.numeric.decimal.antril",
          "match": "\\b\\d[\\d_]*(\\.\\d[\\d_]*)?([eE][+-]?\\d+)?(_?[iuf]\\d+)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "comment": "The type groups of a generic constraint: T : copy, unmanaged",
          "name": "storage.modifier.constraint.antril",
          "match": "\\b(class|value|plain|copy|unmanaged|managed|fixedsize|numeric|integer|int|uint|float|number|snumber|attribute|exception)\\b(?=\\s*[,>])"
        },
        {
          "name": "meta.borrow.mut.antril",
          "match": "(&)\\s*(mut)\\b",
          "captures": {
            "1": {
              "name": "keyword.operator.borrow.antril"
            },
            "2": {
              "name": "storage.modifier.mut.antril"
            }
          }
        },
        {
          "name": "keyword.control.effect.antril",
          "match": "\\b(effect)\\b(?=\\s*\\{)"
        },
        {
          "name": "storage.modifier.reactive.antril",
          "match": "\\b(reactive|computed|reacts)\\b(?=\\s+[A-Za-z_])"
        },
        {
          "name": "keyword.control.antril",
          "match": "\\b(if|else|loop|do|in|switch|try|catch|finally|throw|return|break|continue|when|await)\\b"
        },
        {
          "name": "keyword.operator.new.antril",
          "match": "\\b(new)\\b"
        },
        {
          "name": "storage.type.destructor.antril",
          "match": "\\b(destroy)\\b"
        },
        {
          "name": "keyword.operator.expression.delete.antril",
          "match": "\\b(delete)\\b"
        },
        {
          "name": "keyword.operator.expression.pattern.antril",
          "match": "\\b(is|as|and|or|not|with)\\b"
        },
        {
          "name": "keyword.operator.sizeof.antril",
          "match": "\\b(sizeof)\\b"
        },
        {
          "name": "keyword.operator.typeid.antril",
          "match": "\\b(typeof|default)\\b(?=\\s*\\()"
        },
        {
          "name": "storage.modifier.antril",
          "match": "\\b(public|private|internal|friendly|inherited|file|fixed|readonly|static|virtual|override|base|unsafe|region|variadic|out|extern|bitflag|final|async|const)\\b|\\b(left|right)\\b(?=\\s+op\\b)|\\b(precedence|associativity)\\b(?=\\s*\\()"
        },
        {
          "comment": "A C function pointer type: func*<i32, void*> : bool, func* : Sample*",
          "name": "storage.type.antril",
          "match": "\\bfunc\\*"
        },
        {
          "name": "storage.type.antril",
          "match": "\\b(class|interface|enum|func|op|namespace|value|record|ext)\\b(?=\\s*[A-Za-z_<:(]|\\s*$)"
        },
        {
          "name": "keyword.other.antril",
          "match": "\\b(import|into|from|declbits|allbits)\\b"
        },
        {
          "name": "constant.language.antril",
          "match": "\\b(true|false|null)\\b"
        },
        {
          "name": "variable.language.antril",
          "match": "\\b(this)\\b"
        },
        {
          "name": "storage.modifier.accessor.antril",
          "match": "\\b(get|set)\\b(?=\\s*(=>|\\{|;))"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.antril",
          "match": "\\b(bool|i8|i16|i32|i64|i128|i256|u8|u16|u32|u64|u128|u256|iptr|uptr|f16|f32|f64|f128|f256|char|str|any|void)\\b"
        },
        {
          "comment": "A type used through its name: Console.WriteLine, Array.Sort, Int32.TryParse (a capitalized name before a dot)",
          "match": "\\b([A-Z]\\w*)(?=\\s*\\.\\s*[A-Za-z_])",
          "name": "entity.name.type.antril"
        },
        {
          "comment": "A type before type arguments: List<i32> (not a generic function called: Id<i32>(x))",
          "match": "\\b([A-Z]\\w*)(?=<[\\w\\s,.<>\\[\\]?*:]*>)(?!<[\\w\\s,.<>\\[\\]?*:]*>\\s*\\()",
          "name": "entity.name.type.antril"
        },
        {
          "comment": "After new, is, as, typeof( and sizeof(",
          "match": "(?<=\\bnew\\s|\\bis\\s|\\bas\\s|typeof\\(|sizeof\\(|default\\()\\s*([A-Z]\\w*)",
          "captures": {
            "1": {
              "name": "entity.name.type.antril"
            }
          }
        },
        {
          "comment": "A declared variable or parameter: Point p, Shape? s, i32[] xs",
          "match": "\\b([A-Z]\\w*)(?=(\\[,*\\]|\\?|\\*)*\\s+[A-Za-z_]\\w*\\s*([=;,)]|\\bin\\b))",
          "name": "entity.name.type.antril"
        },
        {
          "comment": "After a colon: results, bases, constraints",
          "match": "(?<=:)\\s*([A-Z]\\w*)",
          "captures": {
            "1": {
              "name": "entity.name.type.antril"
            }
          }
        },
        {
          "comment": "A type argument: List<Item>, Dictionary<str, Point>, func<Item> : bool",
          "match": "(?<=<|,|, )\\s*([A-Z]\\w*)(?=\\s*(\\[,*\\]|\\?)*\\s*[,>])",
          "captures": {
            "1": {
              "name": "entity.name.type.antril"
            }
          }
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_]\\w*)\\s*(?=(<[\\w\\s,.<>\\[\\]?*]*>)?\\s*\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.antril"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.antril",
          "match": "=>|->"
        },
        {
          "name": "keyword.operator.null.antril",
          "match": "\\?\\?|\\?\\."
        },
        {
          "name": "keyword.operator.range.antril",
          "match": "\\.\\.=?|\\.\\.\\."
        },
        {
          "name": "keyword.operator.comparison.antril",
          "match": "==|!=|<=|>="
        },
        {
          "name": "keyword.operator.logical.antril",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.assignment.antril",
          "match": "(\\+|-|\\*|/|%|&|\\||\\^|<<)?="
        },
        {
          "name": "keyword.operator.antril",
          "match": "[+\\-*/%&|^~<>]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.statement.antril",
          "match": ";"
        },
        {
          "name": "punctuation.separator.comma.antril",
          "match": ","
        },
        {
          "name": "punctuation.accessor.antril",
          "match": "\\."
        }
      ]
    }
  }
}
